<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="40dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:text="@string/customize_title"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ===== MÀU CHỦ ĐẠO (accent: đổi màu thẻ Chỉ đường + nút mic) ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="@string/customize_theme"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

            <LinearLayout android:id="@+id/btnAccentPurple" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.imageview.ShapeableImageView android:layout_width="72dp" android:layout_height="88dp" android:src="@drawable/bg_hero_purple" app:cornerSize="20dp" android:scaleType="centerCrop" android:clickable="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_hero_purple" android:textSize="10sp" android:textColor="#616161" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAccentBlue" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="12dp">
                <com.google.android.material.imageview.ShapeableImageView android:layout_width="72dp" android:layout_height="88dp" android:src="@drawable/bg_hero_blue" app:cornerSize="20dp" android:scaleType="centerCrop" android:clickable="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_hero_blue" android:textSize="10sp" android:textColor="#616161" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAccentGreen" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="12dp">
                <com.google.android.material.imageview.ShapeableImageView android:layout_width="72dp" android:layout_height="88dp" android:src="@drawable/bg_hero_green" app:cornerSize="20dp" android:scaleType="centerCrop" android:clickable="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_hero_green" android:textSize="10sp" android:textColor="#616161" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAccentOrange" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="12dp">
                <com.google.android.material.imageview.ShapeableImageView android:layout_width="72dp" android:layout_height="88dp" android:src="@drawable/bg_hero_orange" app:cornerSize="20dp" android:scaleType="centerCrop" android:clickable="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/theme_hero_orange" android:textSize="10sp" android:textColor="#616161" android:layout_marginTop="6dp"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== MÀU CHỮ ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="@string/customize_text_color"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <View android:id="@+id/btnTextColorNavy" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_circle_icon_grey" android:backgroundTint="#201B3D" />
            <View android:id="@+id/btnTextColorBlack" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_circle_icon_grey" android:backgroundTint="#000000" />
            <View android:id="@+id/btnTextColorPurple" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_circle_icon_grey" android:backgroundTint="#4B36A8" />
            <View android:id="@+id/btnTextColorTeal" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_circle_icon_grey" android:backgroundTint="#0F766E" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== CỠ CHỮ ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="@string/customize_font_size"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontSmall"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/font_small"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontNormal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/font_normal"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#5C4FE0"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontLarge"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/font_large"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <!-- ===== BO GÓC THẺ ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="@string/customize_corner"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCornerSharp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/corner_sharp"
            android:textColor="#5C4FE0"
            android:textSize="12sp"
            app:cornerRadius="4dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCornerRound"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/corner_round"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#5C4FE0"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCornerPill"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/corner_pill"
            android:textColor="#5C4FE0"
            android:textSize="12sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <!-- ===== NGÔN NGỮ / LANGUAGE ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/customize_language"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLangVi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Tiếng Việt"
            android:textSize="13sp"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLangEn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="English"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="#F0F0F0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogoutFromSettings"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/account_logout"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
