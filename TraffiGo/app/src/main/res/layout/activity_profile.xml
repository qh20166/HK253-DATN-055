<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/btnChangePicture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_change_avatar"
                android:textColor="#673AB7"
                android:textStyle="bold" />

            <TextView style="@style/LabelStyle" android:text="@string/profile_label_name" />
            <EditText android:id="@+id/edtName" style="@style/FieldStyle" android:hint="@string/profile_hint_name" />

            <TextView style="@style/LabelStyle" android:text="@string/label_email" />
            <EditText android:id="@+id/edtEmail" style="@style/FieldStyle" android:enabled="false" />

            <TextView style="@style/LabelStyle" android:text="@string/profile_label_phone" />
            <EditText android:id="@+id/edtPhone" style="@style/FieldStyle"  android:inputType="phone" />

            <TextView style="@style/LabelStyle" android:text="@string/profile_label_password" />
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/edtPassword"
                    style="@style/FieldStyle"
                    android:inputType="textPassword"
                    android:hint="@string/profile_hint_new_password"
                    android:paddingEnd="48dp" />
                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_eye_hide"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_show_hide_password"
                    app:tint="#999999" />
            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#514291"
                android:text="@string/profile_save"
                android:textAllCaps="false"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>