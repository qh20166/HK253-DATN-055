<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_listening"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:alpha="0.85" />

        <TextView
            android:id="@+id/tvVoiceHeard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:minHeight="72dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1" />

        <!-- Mic pulse -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="40dp">

            <View
                android:id="@+id/voicePulse"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_voice_pulse" />

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_voice_mic">

                <ImageView
                    android:id="@+id/ivVoiceMic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="#FFFFFF"
                    android:contentDescription="@string/voice_mic_cd" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/voice_hint"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.55" />
    </LinearLayout>
</FrameLayout>
