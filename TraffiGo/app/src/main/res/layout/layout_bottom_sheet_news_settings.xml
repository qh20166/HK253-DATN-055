<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:text="@string/news_settings_title"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ===== TỐC ĐỘ ĐỌC ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="@string/news_settings_speed"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed075"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/speed_075"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed100"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/speed_100"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed125"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/speed_125"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed150"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/speed_150"
            android:textColor="#5C4FE0"
            android:textSize="13sp"
            app:cornerRadius="22dp"
            app:strokeColor="#5C4FE0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>
