<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_header" />

    <!-- Map image — fills remaining space above bottom bar -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/imgFullMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/cd_offline_map"
        android:scaleType="fitCenter" />

    <!-- Bottom action bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:elevation="16dp">

        <!-- Coordinates row -->
        <LinearLayout
            android:id="@+id/layoutCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                app:tint="#9E8FD8"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.7767, 106.6656"
                android:textColor="#9E8FD8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenInMap"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/offline_open_in_map"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#5C4FE0"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteMap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/btn_delete"
                android:textColor="#E53935"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E53935"
                app:strokeWidth="1.5dp"
                app:backgroundTint="@android:color/transparent" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
